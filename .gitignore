# Python caches and build artifacts
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*

# Virtual environments
.venv/
venv/
env/

# Secrets / local env
.env
.env.*

# IDE / editor
.vscode/
.idea/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db

# Local agent/runtime config (not part of the package)
.claude/

# ROMs, save files, emulator binaries (never commit - copyrighted)
*.gba
*.gb
*.gbc
*.nds
*.iso
*.bin
*.sav
*.state
Emulator/

# Model weights and checkpoints
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.pkl
*.joblib
*.gguf
*.npz
*.npy

# Debug captures / run outputs
*.log
debug_*.png
perception_debug_*.jpg
runs/
logs/

# Session logs (local working logs; canonical copies live in the Obsidian vault
# on Tim's PC). Convention: every project under ~/projects/<name>/ has a
# gitignored sessions/ subfolder.
sessions/
train/ocr/data*/
train/ocr/ckpt*/
train/policy/data*/
train/policy/ckpt*/
captures/

# F18 font corpus (downloaded; do not commit)
train/ocr/corpus/

# Decomp/ROM real-glyph font assets (copyrighted game graphics: training input
# only, NOT redistributed -- same policy as ROMs/captures). See DECOMP_FONT_PLAYBOOK.
train/ocr/fonts/decomp/

# Downloaded model weights (fetch on demand; see train/ocr/detect_east.py)
train/ocr/models/

# Captured game frames + savestates (copyrighted game data: local training
# input only, NOT redistributed -- same policy as ROMs/captures)
train/perception/mode_data/
train/ram/*.state
train/ram/smoke_frame.png

# Scratch/underscore-prefixed debug images and scratch dirs (2026-08-09)
_*.png
**/_*.png
train/rl/scratch/
train/rl/distill_data/
# Underscore-prefixed scratch scripts + scratch dirs (one-off probes/dev tools).
# _[a-z]* matches single-underscore scratch (_alttp_*, _enemy_eyes, ...) but NOT
# double-underscore dunders (__init__.py, __main__.py), which must stay tracked.
_[a-z]*.py
**/_[a-z]*.py
_[a-z]*/
**/_[a-z]*/
